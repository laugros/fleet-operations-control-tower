{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/backlog/demo-r1-implementation-backlog.schema.json",
  "title": "DEMO-R1 Implementation Backlog v2.1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backlog_version",
    "release",
    "status",
    "scaffold_authorized",
    "source_traceability",
    "contract_inventory",
    "id_policy",
    "planning_policy",
    "operation_ownership",
    "event_ownership",
    "gate_controls",
    "work_packages"
  ],
  "properties": {
    "backlog_version": {
      "const": "2.1.3"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "status": {
      "const": "NORMATIVE_PENDING_FINAL_REVIEW"
    },
    "scaffold_authorized": {
      "const": false
    },
    "source_traceability": {
      "type": "string"
    },
    "contract_inventory": {
      "type": "object"
    },
    "id_policy": {
      "type": "object"
    },
    "planning_policy": {
      "type": "object"
    },
    "operation_ownership": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "method",
          "path",
          "primary_owner_work_package",
          "contributing_work_packages",
          "success_test_id"
        ],
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "primary_owner_work_package": {
            "type": "string"
          },
          "contributing_work_packages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "success_test_id": {
            "type": "string"
          }
        }
      }
    },
    "event_ownership": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "type": "object"
      }
    },
    "gate_controls": {
      "type": "object"
    },
    "work_packages": {
      "type": "array",
      "minItems": 59,
      "maxItems": 59,
      "items": {
        "type": "object",
        "required": [
          "work_package_id",
          "requirement_id",
          "title",
          "classification",
          "release_blocking",
          "priority",
          "complexity",
          "implementation_type",
          "gate",
          "wave",
          "sequence",
          "depends_on",
          "parallel_after_dependencies",
          "actors",
          "ui_ids",
          "commands",
          "primary_operation_ids",
          "contributing_operation_ids",
          "operation_sets",
          "permissions_or_capabilities",
          "tables",
          "semantic_event_types",
          "producer_event_types",
          "event_sets",
          "acceptance_test_ids",
          "e2e_ids",
          "implementation_slices",
          "acceptance_criteria",
          "definition_of_done",
          "implementation_notes",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "work_package_id": {
            "type": "string",
            "pattern": "^WP-DEMO-[A-Z]+-[0-9]{3}$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^DEMO-[A-Z]+-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "DEMO-MUST",
              "TECHNICAL-SUPPORT"
            ]
          },
          "release_blocking": {
            "const": true
          },
          "priority": {
            "enum": [
              "P0",
              "P1"
            ]
          },
          "complexity": {
            "enum": [
              "S",
              "M",
              "L",
              "XL"
            ]
          },
          "implementation_type": {
            "type": "string"
          },
          "gate": {
            "enum": [
              "G1_FOUNDATION",
              "G2_DOMAIN",
              "G3_PROJECTIONS",
              "G4_TIME_COMMUNICATION",
              "G5_EXTERNAL"
            ]
          },
          "wave": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 59
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "parallel_after_dependencies": {
            "const": true
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ui_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "primary_operation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "contributing_operation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "operation_sets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions_or_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semantic_event_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "producer_event_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "event_sets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_test_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "e2e_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "implementation_slices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "slice_id",
                "title",
                "effort_points",
                "scope",
                "acceptance_test_ids",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "slice_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "effort_points": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "scope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "acceptance_test_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "status": {
                  "const": "BLOCKED_PENDING_FINAL_REVIEW"
                }
              }
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_of_done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "const": "BLOCKED_PENDING_FINAL_REVIEW"
          }
        }
      }
    }
  }
}
