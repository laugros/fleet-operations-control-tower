{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/domain/demo-r1-command-registry.schema.json",
  "title": "DEMO-R1 Command Registry v2.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "release",
    "status",
    "event_registry",
    "policies",
    "commands"
  ],
  "properties": {
    "registry_version": {
      "const": "2.1.4"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "status": {
      "const": "NORMATIVE_COMMAND_REGISTRY"
    },
    "event_registry": {
      "type": "string"
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_primary_event_per_command_transaction",
        "system_commands_replay_execution",
        "generation_guard_required",
        "manual_external_access_revocation",
        "forbidden_command_codes"
      ],
      "properties": {
        "one_primary_event_per_command_transaction": {
          "const": true
        },
        "system_commands_replay_execution": {
          "const": "FORBIDDEN"
        },
        "generation_guard_required": {
          "const": true
        },
        "manual_external_access_revocation": {
          "const": "FORBIDDEN"
        },
        "forbidden_command_codes": {
          "type": "array",
          "contains": {
            "const": "RevokeExternalAccess"
          },
          "uniqueItems": true
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_code",
          "mode",
          "execution",
          "aggregate_types",
          "primary_event_types",
          "producer_codes",
          "source_operation_ids",
          "source_event_types",
          "trigger_conditions",
          "idempotency_rule",
          "replay_execution",
          "generation_guard"
        ],
        "properties": {
          "command_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$",
            "not": {
              "const": "RevokeExternalAccess"
            }
          },
          "mode": {
            "enum": [
              "USER_OR_EXTERNAL",
              "SYSTEM",
              "CONTROL",
              "ADAPTER"
            ]
          },
          "execution": {
            "enum": [
              "DIRECT",
              "LIVE_ONLY",
              "DIRECT_CONTROL",
              "DIRECT_ADAPTER"
            ]
          },
          "aggregate_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "primary_event_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "producer_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_operation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_event_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "trigger_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "idempotency_rule": {
            "type": "string",
            "minLength": 1
          },
          "replay_execution": {
            "const": "FORBIDDEN"
          },
          "generation_guard": {
            "enum": [
              "ACTIVE_GENERATION_REQUIRED",
              "CONTROL_GENERATION_TRANSITION"
            ]
          }
        }
      }
    }
  }
}
