      "area": "hash integrity and authorized root",
      "blocks_merge": true,
      "evidence": "A semantically changed fixture passes after assembly and all mutable hashes are recomputed.",
      "recommended_correction": "Verify against an independently authorized immutable root and reject semantic drift without a new embedded decision."
    },
    {
      "id": "PR1-BLK-002-A",
      "severity": "BLOCKER",
      "area": "ordered used_by_test_ids equality",
      "blocks_merge": true,
      "evidence": "The verifier sorts observed arrays; a reversed order propagated consistently passes.",
      "recommended_correction": "Compare every observed array directly with one canonical expected order and add a negative order test."
    },
    {
      "id": "PR1-BLK-003-A",
      "severity": "BLOCKER",
      "area": "real runner event generation contract",
      "blocks_merge": true,
      "evidence": "The runner ignores event_assertions.demo_generation_id and passes an event whose generation differs from the active generation after the producing transaction.",
      "recommended_correction": "Execute the declared generation assertion and prove the active-generation rule at the transactional production point."
    },
    {
      "id": "PR1-BLK-005",
      "severity": "BLOCKER",
      "area": "formal incorporation authorization",
      "blocks_merge": true,
      "evidence": "No repository-embedded decision exists after R7; 18 manifested artifacts changed while the baseline still declares R7.",
      "recommended_correction": "After technical closure and independent re-review, embed a new formal decision and perform authorized post-assembly verification."
    },
    {
      "id": "R8-MAJ-001",
      "severity": "MAJOR",
      "area": "declared assertion coverage",
      "blocks_merge": true,
      "evidence": "Some database/security expectations and operationId conformance are declared but have no complete executor/evidence record.",
      "recommended_correction": "Require one executed and evidenced result for every declared assertion."
    },
    {
      "id": "R8-MAJ-002",
      "severity": "MAJOR",
      "area": "database_diff evidence isolation",
      "blocks_merge": true,
      "evidence": "The before snapshot precedes fixture restoration, so database_diff mixes fixture preparation with contract effects and only reports counts.",
      "recommended_correction": "Restore before snapshot and separate preparation, action and rollback diffs at relevant row level."
    },
    {
      "id": "R8-MIN-001",
      "severity": "MINOR",
      "area": "Windows runner portability",
      "blocks_merge": false,
