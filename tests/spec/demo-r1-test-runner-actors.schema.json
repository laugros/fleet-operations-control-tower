{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/tests/demo-r1-test-runner-actors.schema.json",
  "title": "DEMO-R1 Test Runner Actors v2.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "release",
    "status",
    "profiles"
  ],
  "properties": {
    "registry_version": {
      "const": "2.1.4"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "status": {
      "const": "NORMATIVE_AUTHORIZED_FOR_SCAFFOLD"
    },
    "profiles": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_code",
          "auth_mode",
          "role_code",
          "audience",
          "cookie_credential_ref",
          "csrf_credential_ref",
          "adapter_secret_ref",
          "source_operation_id",
          "required_capture_names"
        ],
        "properties": {
          "profile_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "auth_mode": {
            "enum": [
              "INTERNAL_SESSION",
              "HMAC_ADAPTER",
              "NONE",
              "CAPTURED_EXTERNAL_SESSION"
            ]
          },
          "role_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "audience": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SUPPLIER",
              "DRIVER",
              null
            ]
          },
          "cookie_credential_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "csrf_credential_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "adapter_secret_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_capture_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
