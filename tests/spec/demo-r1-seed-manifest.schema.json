{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/seed/demo-r1-seed-manifest.schema.json",
  "title": "DEMO-R1 Seed Manifest v2.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "release",
    "seed_version",
    "status",
    "namespace",
    "clock",
    "generation",
    "restore_protocol",
    "compatibility_aliases",
    "fixtures",
    "seed_contract",
    "seed_contract_sha256",
    "seed_contract_digest_protocol"
  ],
  "properties": {
    "manifest_version": {
      "const": "2.1.4"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "seed_version": {
      "const": "2.1.4"
    },
    "status": {
      "const": "NORMATIVE_AUTHORIZED_FOR_SCAFFOLD"
    },
    "namespace": {
      "const": "https://fotc.local/demo-r1/v2.1.4/"
    },
    "clock": {
      "type": "object",
      "required": [
        "initial_time",
        "timezone"
      ],
      "additionalProperties": false,
      "properties": {
        "initial_time": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "active_generation_id",
        "retired_generation_id",
        "runtime_status_after_restore"
      ],
      "additionalProperties": false,
      "properties": {
        "active_generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "retired_generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_status_after_restore": {
          "const": "ACTIVE"
        }
      }
    },
    "restore_protocol": {
      "type": "object",
      "required": [
        "input_file",
        "transaction",
        "advisory_lock_key",
        "table_policy",
        "table_load_order",
        "derived_value_protocol",
        "projection_strategy",
        "checksum_algorithm",
        "fail_on_unknown_table",
        "fail_on_unknown_column",
        "fail_on_unresolved_reference",
        "manifest_digest_protocol",
        "layer_contract_file",
        "table_contract_file",
        "restore_profile_required",
        "full_release_profile",
        "layered_resolved_seed_files",
        "source_projection_policy",
        "post_restore_action_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "input_file": {
          "type": "string"
        },
        "transaction": {
          "const": "SERIALIZABLE"
        },
        "advisory_lock_key": {
          "type": "string"
        },
        "table_policy": {
          "const": "REPLACE_ALL_RESETTABLE"
        },
        "table_load_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "derived_value_protocol": {
          "type": "object"
        },
        "projection_strategy": {
          "type": "string"
        },
        "checksum_algorithm": {
          "const": "SHA-256"
        },
        "fail_on_unknown_table": {
          "const": true
        },
        "fail_on_unknown_column": {
          "const": true
        },
        "fail_on_unresolved_reference": {
          "const": true
        },
        "manifest_digest_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "target_column",
            "fail_on_mismatch"
          ],
          "properties": {
            "source": {
              "const": "seed_contract_sha256"
            },
            "target_column": {
              "const": "demo_seed_manifest.manifest_sha256"
            },
            "fail_on_mismatch": {
              "const": true
            }
          }
        },
        "layer_contract_file": {
          "const": "tests/spec/demo-r1-seed-layers.yaml"
        },
        "table_contract_file": {
          "const": "tests/spec/demo-r1-table-contract.yaml"
        },
        "restore_profile_required": {
          "const": true
        },
        "full_release_profile": {
          "const": "G6_EXECUTIVE"
        },
        "layered_resolved_seed_files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "G1_FOUNDATION",
            "G2_DOMAIN",
            "G3_PROJECTIONS",
            "G4_TIME_COMMUNICATION",
            "G5_EXTERNAL",
            "G6_EXECUTIVE"
          ],
          "properties": {
            "G1_FOUNDATION": {
              "const": "tests/spec/seed-layers/g1-foundation.json"
            },
            "G2_DOMAIN": {
              "const": "tests/spec/seed-layers/g2-domain.json"
            },
            "G3_PROJECTIONS": {
              "const": "tests/spec/seed-layers/g3-projections.json"
            },
            "G4_TIME_COMMUNICATION": {
              "const": "tests/spec/seed-layers/g4-time-communication.json"
            },
            "G5_EXTERNAL": {
              "const": "tests/spec/seed-layers/g5-external.json"
            },
            "G6_EXECUTIVE": {
              "const": "tests/spec/seed-layers/g6-executive.json"
            }
          }
        },
        "source_projection_policy": {
          "const": "USE_GATE_BUNDLE; FUTURE_TABLES_MUST_NOT_ENTER_VALIDATION"
        },
        "post_restore_action_policy": {
          "const": "EXECUTE_ONLY_HANDLERS_INSTALLED_BY_SELECTED_GATE"
        }
      }
    },
    "compatibility_aliases": {
      "type": "object"
    },
    "fixtures": {
      "type": "object",
      "minProperties": 98,
      "additionalProperties": {
        "type": "object",
        "required": [
          "resolved_state_ref",
          "state_sha256",
          "used_by_test_ids",
          "purpose"
        ],
        "additionalProperties": false,
        "properties": {
          "resolved_state_ref": {
            "type": "string"
          },
          "state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "used_by_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seed_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "seed_version",
        "namespace",
        "clock",
        "generation",
        "restore_protocol_core",
        "fixture_count",
        "layering"
      ],
      "properties": {
        "release": {
          "const": "DEMO-R1"
        },
        "seed_version": {
          "const": "2.1.4"
        },
        "namespace": {
          "type": "string",
          "format": "uri"
        },
        "clock": {
          "type": "object"
        },
        "generation": {
          "type": "object"
        },
        "restore_protocol_core": {
          "type": "object",
          "properties": {
            "layer_contract_file": {
              "const": "tests/spec/demo-r1-seed-layers.yaml"
            },
            "table_contract_file": {
              "const": "tests/spec/demo-r1-table-contract.yaml"
            },
            "restore_profile_required": {
              "const": true
            },
            "full_release_profile": {
              "const": "G6_EXECUTIVE"
            },
            "layered_resolved_seed_files": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "G1_FOUNDATION",
                "G2_DOMAIN",
                "G3_PROJECTIONS",
                "G4_TIME_COMMUNICATION",
                "G5_EXTERNAL",
                "G6_EXECUTIVE"
              ],
              "properties": {
                "G1_FOUNDATION": {
                  "const": "tests/spec/seed-layers/g1-foundation.json"
                },
                "G2_DOMAIN": {
                  "const": "tests/spec/seed-layers/g2-domain.json"
                },
                "G3_PROJECTIONS": {
                  "const": "tests/spec/seed-layers/g3-projections.json"
                },
                "G4_TIME_COMMUNICATION": {
                  "const": "tests/spec/seed-layers/g4-time-communication.json"
                },
                "G5_EXTERNAL": {
                  "const": "tests/spec/seed-layers/g5-external.json"
                },
                "G6_EXECUTIVE": {
                  "const": "tests/spec/seed-layers/g6-executive.json"
                }
              }
            },
            "source_projection_policy": {
              "const": "USE_GATE_BUNDLE; FUTURE_TABLES_MUST_NOT_ENTER_VALIDATION"
            },
            "post_restore_action_policy": {
              "const": "EXECUTE_ONLY_HANDLERS_INSTALLED_BY_SELECTED_GATE"
            }
          },
          "required": [
            "layer_contract_file",
            "table_contract_file",
            "restore_profile_required",
            "full_release_profile",
            "layered_resolved_seed_files",
            "source_projection_policy",
            "post_restore_action_policy"
          ]
        },
        "fixture_count": {
          "const": 98
        },
        "layering": {
          "type": "object"
        }
      }
    },
    "seed_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_contract_digest_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "source_pointer",
        "target_column",
        "self_reference"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "JSON_SORTED_KEYS_UTF8_NO_WHITESPACE"
        },
        "source_pointer": {
          "const": "/seed_contract"
        },
        "target_column": {
          "const": "demo_seed_manifest.manifest_sha256"
        },
        "self_reference": {
          "const": "FORBIDDEN"
        }
      }
    }
  }
}
