{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/seed/demo-r1-seed-manifest.schema.json",
  "title": "DEMO-R1 Seed Manifest v2.1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "release",
    "seed_version",
    "status",
    "namespace",
    "clock",
    "generation",
    "restore_protocol",
    "compatibility_aliases",
    "fixtures",
    "seed_contract",
    "seed_contract_sha256",
    "seed_contract_digest_protocol"
  ],
  "properties": {
    "manifest_version": {
      "const": "2.1.3"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "seed_version": {
      "const": "2.1.3"
    },
    "status": {
      "const": "NORMATIVE_PENDING_FINAL_REVIEW"
    },
    "namespace": {
      "type": "string",
      "format": "uri"
    },
    "clock": {
      "type": "object",
      "required": [
        "initial_time",
        "timezone"
      ],
      "additionalProperties": false,
      "properties": {
        "initial_time": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "active_generation_id",
        "retired_generation_id",
        "runtime_status_after_restore"
      ],
      "additionalProperties": false,
      "properties": {
        "active_generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "retired_generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_status_after_restore": {
          "const": "ACTIVE"
        }
      }
    },
    "restore_protocol": {
      "type": "object",
      "required": [
        "input_file",
        "transaction",
        "advisory_lock_key",
        "table_policy",
        "table_load_order",
        "derived_value_protocol",
        "projection_strategy",
        "checksum_algorithm",
        "fail_on_unknown_table",
        "fail_on_unknown_column",
        "fail_on_unresolved_reference",
        "manifest_digest_protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "input_file": {
          "type": "string"
        },
        "transaction": {
          "const": "SERIALIZABLE"
        },
        "advisory_lock_key": {
          "type": "string"
        },
        "table_policy": {
          "const": "REPLACE_ALL_RESETTABLE"
        },
        "table_load_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "derived_value_protocol": {
          "type": "object"
        },
        "projection_strategy": {
          "type": "string"
        },
        "checksum_algorithm": {
          "const": "SHA-256"
        },
        "fail_on_unknown_table": {
          "const": true
        },
        "fail_on_unknown_column": {
          "const": true
        },
        "fail_on_unresolved_reference": {
          "const": true
        },
        "manifest_digest_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "target_column",
            "fail_on_mismatch"
          ],
          "properties": {
            "source": {
              "const": "seed_contract_sha256"
            },
            "target_column": {
              "const": "demo_seed_manifest.manifest_sha256"
            },
            "fail_on_mismatch": {
              "const": true
            }
          }
        }
      }
    },
    "compatibility_aliases": {
      "type": "object"
    },
    "fixtures": {
      "type": "object",
      "minProperties": 98,
      "additionalProperties": {
        "type": "object",
        "required": [
          "resolved_state_ref",
          "state_sha256",
          "used_by_test_ids",
          "purpose"
        ],
        "additionalProperties": false,
        "properties": {
          "resolved_state_ref": {
            "type": "string"
          },
          "state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "used_by_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seed_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "seed_version",
        "namespace",
        "clock",
        "generation",
        "restore_protocol_core",
        "fixture_count"
      ],
      "properties": {
        "release": {
          "const": "DEMO-R1"
        },
        "seed_version": {
          "const": "2.1.3"
        },
        "namespace": {
          "type": "string",
          "format": "uri"
        },
        "clock": {
          "type": "object"
        },
        "generation": {
          "type": "object"
        },
        "restore_protocol_core": {
          "type": "object"
        },
        "fixture_count": {
          "const": 98
        }
      }
    },
    "seed_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_contract_digest_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "source_pointer",
        "target_column",
        "self_reference"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "JSON_SORTED_KEYS_UTF8_NO_WHITESPACE"
        },
        "source_pointer": {
          "const": "/seed_contract"
        },
        "target_column": {
          "const": "demo_seed_manifest.manifest_sha256"
        },
        "self_reference": {
          "const": "FORBIDDEN"
        }
      }
    }
  }
}
