{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/tests/demo-r1-test-fixtures.schema.json",
  "title": "DEMO-R1 Test Fixtures v2.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "release",
    "reference_protocol",
    "values",
    "credentials",
    "computed",
    "snapshots",
    "seed_aliases",
    "seed_manifest_file",
    "resolved_seed_file",
    "layered_resolved_seed_files"
  ],
  "properties": {
    "fixture_version": {
      "const": "2.1.4"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "reference_protocol": {
      "type": "object"
    },
    "values": {
      "type": "object"
    },
    "credentials": {
      "type": "object"
    },
    "computed": {
      "type": "object"
    },
    "seed_manifest_file": {
      "const": "tests/spec/demo-r1-seed-manifest.yaml"
    },
    "resolved_seed_file": {
      "const": "tests/spec/demo-r1-resolved-seeds.json"
    },
    "snapshots": {
      "type": "object",
      "minProperties": 25,
      "maxProperties": 25,
      "additionalProperties": {
        "type": "object",
        "required": [
          "generation_id",
          "runtime_status",
          "actor_context",
          "resources",
          "seed_manifest_ref",
          "resolved_state_ref",
          "state_sha256"
        ],
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          },
          "runtime_status": {
            "enum": [
              "ACTIVE",
              "RESETTING",
              "FAILED_SAFE"
            ]
          },
          "actor_context": {
            "type": "string"
          },
          "resources": {
            "type": "object"
          },
          "seed_manifest_ref": {
            "type": "string",
            "pattern": "^demo-r1-v2\\.1\\.3/FX-"
          },
          "resolved_state_ref": {
            "type": "string"
          },
          "state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "seed_aliases": {
      "type": "object",
      "minProperties": 73,
      "maxProperties": 73,
      "additionalProperties": {
        "type": "object",
        "required": [
          "seed_manifest_ref",
          "resolved_state_ref",
          "state_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "seed_manifest_ref": {
            "type": "string",
            "pattern": "^demo-r1-v2\\.1\\.3/FX-"
          },
          "resolved_state_ref": {
            "type": "string"
          },
          "state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "layered_resolved_seed_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G1_FOUNDATION",
        "G2_DOMAIN",
        "G3_PROJECTIONS",
        "G4_TIME_COMMUNICATION",
        "G5_EXTERNAL",
        "G6_EXECUTIVE"
      ],
      "properties": {
        "G1_FOUNDATION": {
          "const": "tests/spec/seed-layers/g1-foundation.json"
        },
        "G2_DOMAIN": {
          "const": "tests/spec/seed-layers/g2-domain.json"
        },
        "G3_PROJECTIONS": {
          "const": "tests/spec/seed-layers/g3-projections.json"
        },
        "G4_TIME_COMMUNICATION": {
          "const": "tests/spec/seed-layers/g4-time-communication.json"
        },
        "G5_EXTERNAL": {
          "const": "tests/spec/seed-layers/g5-external.json"
        },
        "G6_EXECUTIVE": {
          "const": "tests/spec/seed-layers/g6-executive.json"
        }
      }
    }
  }
}
