{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/tests/demo-r1-test-runner-db-operations.schema.json",
  "title": "DEMO-R1 Test Runner DB Operation Registry v2.1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "release",
    "status",
    "operations"
  ],
  "properties": {
    "registry_version": {
      "const": "2.1.3"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "status": {
      "const": "NORMATIVE_PENDING_FINAL_REVIEW"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_code",
          "handler_id",
          "transaction_isolation",
          "rollback_policy",
          "args_schema",
          "effects",
          "required_assertions"
        ],
        "properties": {
          "operation_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "handler_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "transaction_isolation": {
            "const": "SERIALIZABLE"
          },
          "rollback_policy": {
            "enum": [
              "ALWAYS",
              "ON_ASSERTION_FAILURE",
              "COMMIT"
            ]
          },
          "args_schema": {
            "type": "object"
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
