{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/tests/demo-r1-test-runner-programs.schema.json",
  "title": "DEMO-R1 Test Runner Programs v2.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_version",
    "release",
    "database_programs",
    "scenario_programs"
  ],
  "properties": {
    "program_version": {
      "const": "2.1.4"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "database_programs": {
      "type": "object",
      "minProperties": 43,
      "maxProperties": 43,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_id",
          "fixture_id",
          "transaction",
          "steps"
        ],
        "properties": {
          "program_id": {
            "type": "string"
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^FX-"
          },
          "transaction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "isolation",
              "rollback"
            ],
            "properties": {
              "isolation": {
                "const": "SERIALIZABLE"
              },
              "rollback": {
                "const": "ALWAYS"
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_id",
                "op",
                "target_table",
                "source",
                "mutations",
                "expect"
              ],
              "properties": {
                "step_id": {
                  "type": "string"
                },
                "op": {
                  "enum": [
                    "CLONE_INSERT",
                    "PATCH_UPDATE",
                    "QUERY_ASSERT",
                    "SERVICE_CALL",
                    "FAULT_INJECTION",
                    "RESET_AND_ASSERT",
                    "METRIC_ASSERT"
                  ]
                },
                "target_table": {
                  "type": "string"
                },
                "source": {
                  "type": "object"
                },
                "mutations": {
                  "type": "array"
                },
                "expect": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "scenario_programs": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_id",
          "fixture_id",
          "timeout_ms",
          "steps"
        ],
        "properties": {
          "program_id": {
            "type": "string"
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^FX-"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "operation_id",
                    "actor",
                    "path_params",
                    "query",
                    "body",
                    "idempotency_key",
                    "expect_status",
                    "capture"
                  ],
                  "properties": {
                    "op": {
                      "const": "HTTP_OPERATION"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "operation_id": {
                      "type": "string"
                    },
                    "actor": {
                      "enum": [
                        "CAPTURED_EXTERNAL_DRIVER",
                        "CAPTURED_EXTERNAL_SUPPLIER",
                        "DEMO_ADMIN",
                        "DEMO_ATTENDANT",
                        "DEMO_MANAGER",
                        "DEMO_OPERATIONS_ANALYST",
                        "DEMO_SUPERVISOR",
                        "EXTERNAL_ANONYMOUS",
                        "FAKE_EMAIL_ADAPTER"
                      ]
                    },
                    "path_params": {
                      "type": "object"
                    },
                    "query": {
                      "type": "object"
                    },
                    "body": {},
                    "idempotency_key": {
                      "type": "string"
                    },
                    "expect_status": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 599
                          },
                          "uniqueItems": true
                        }
                      ]
                    },
                    "capture": {
                      "type": "object"
                    },
                    "actor_output_profile": {
                      "enum": [
                        "CAPTURED_EXTERNAL_DRIVER",
                        "CAPTURED_EXTERNAL_SUPPLIER",
                        "DEMO_ADMIN",
                        "DEMO_ATTENDANT",
                        "DEMO_MANAGER",
                        "DEMO_OPERATIONS_ANALYST",
                        "DEMO_SUPERVISOR",
                        "EXTERNAL_ANONYMOUS",
                        "FAKE_EMAIL_ADAPTER"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "event_types",
                    "minimum_count",
                    "timeout_ms"
                  ],
                  "properties": {
                    "op": {
                      "const": "WAIT_EVENT"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "event_types": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "minimum_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "timeout_ms": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "duration",
                    "actor"
                  ],
                  "properties": {
                    "op": {
                      "const": "ADVANCE_CLOCK"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "duration": {
                      "type": "string",
                      "pattern": "^P"
                    },
                    "actor": {
                      "const": "DEMO_ADMIN"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "worker_code",
                    "drain",
                    "timeout_ms"
                  ],
                  "properties": {
                    "op": {
                      "const": "RUN_WORKER"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "worker_code": {
                      "enum": [
                        "alert-evaluator",
                        "arrival-evaluator",
                        "demo-reset-recovery-watchdog",
                        "fake-email-inbox-consumer"
                      ]
                    },
                    "drain": {
                      "type": "boolean"
                    },
                    "timeout_ms": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "assertions"
                  ],
                  "properties": {
                    "op": {
                      "const": "ASSERT_STATE"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "assertions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "operator",
                          "expected"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "operator": {
                            "enum": [
                              "EQ",
                              "COUNT_EQ",
                              "NOT_NULL",
                              "IS_NULL",
                              "GT"
                            ]
                          },
                          "expected": {}
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "command_step"
                  ],
                  "properties": {
                    "op": {
                      "const": "DOMAIN_COMMAND"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "command_step": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "step_id",
                        "command",
                        "aggregate_ref",
                        "payload",
                        "expected_version",
                        "idempotency_key",
                        "caused_by_event_ref",
                        "expect",
                        "capture"
                      ],
                      "properties": {
                        "op": {
                          "const": "COMMAND"
                        },
                        "step_id": {
                          "type": "string"
                        },
                        "command": {
                          "enum": [
                            "AdvanceDemoClock",
                            "AssignTask",
                            "AutoRevokeExternalAccess",
                            "CancelTask",
                            "CloseVehicleStop",
                            "CompleteArrivalConflictTask",
                            "CompleteService",
                            "CompleteTask",
                            "ConfirmArrival",
                            "ConfirmConversationCaseLink",
                            "ConfirmDeparture",
                            "CorrectArrival",
                            "CreateArrivalConflictAlert",
                            "CreateArrivalConflictTask",
                            "CreateTask",
                            "EvaluateArrivalReports",
                            "EvaluateStopInactivity",
                            "IssueDriverAccess",
                            "IssueSupplierAccess",
                            "PrepareStopForArrival",
                            "ReceiveInboundEmail",
                            "RecordPhoneCall",
                            "ReleaseVehicle",
                            "ReportArrival",
                            "ResetDemoScenario",
                            "ResolveArrivalConflictAlert",
                            "ResolveCase",
                            "ResolveStopNoUpdateAlert",
                            "ResumeCaseAfterSupplierUpdate",
                            "ResumeTaskAfterSupplierUpdate",
                            "StartCaseWork",
                            "StartService",
                            "StartTask",
                            "SuggestConversationCaseLink",
                            "UpdateCompletionForecast",
                            "WaitCaseForSupplier",
                            "WaitTaskForSupplier"
                          ]
                        },
                        "aggregate_ref": {},
                        "payload": {
                          "type": "object"
                        },
                        "expected_version": {},
                        "idempotency_key": {
                          "type": "string"
                        },
                        "caused_by_event_ref": {},
                        "expect": {
                          "enum": [
                            "SUCCESS",
                            "REJECT"
                          ]
                        },
                        "capture": {
                          "type": "object"
                        },
                        "precondition_state": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "step_id",
                    "operation_code",
                    "args"
                  ],
                  "properties": {
                    "op": {
                      "const": "DB_OPERATION"
                    },
                    "step_id": {
                      "type": "string"
                    },
                    "operation_code": {
                      "enum": [
                        "DELETE_AND_RESEED_APP_USER"
                      ]
                    },
                    "args": {
                      "type": "object"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
