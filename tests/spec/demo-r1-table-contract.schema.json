              }
            },
            "schema_only_tables_introduced": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "G4_TIME_COMMUNICATION": {
          "type": "object",
          "additionalProperties": false,
