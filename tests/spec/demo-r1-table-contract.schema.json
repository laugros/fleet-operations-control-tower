            "schema_only_tables_introduced": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "G3_PROJECTIONS": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_tables_introduced",
            "schema_tables_cumulative",
            "seed_tables_introduced",
            "seed_tables_cumulative",
            "schema_only_tables_introduced"
          ],
          "properties": {
            "schema_tables_introduced": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "schema_tables_cumulative": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "seed_tables_introduced": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "seed_tables_cumulative": {
              "type": "array",
