{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/tests/demo-r1-test-action.schema.json",
  "title": "DEMO-R1 Test Action v2.1.4",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "operation_id",
        "method",
        "path_template",
        "resolved_path",
        "path_params",
        "query",
        "headers",
        "credential_refs",
        "body",
        "timeout_ms",
        "capture"
      ],
      "properties": {
        "type": {
          "const": "HTTP"
        },
        "operation_id": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path_template": {
          "type": "string"
        },
        "resolved_path": {
          "type": "string"
        },
        "path_params": {
          "type": "object"
        },
        "query": {
          "type": "object"
        },
        "headers": {
          "type": "object"
        },
        "credential_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "body": {},
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "capture": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requests",
        "barrier",
        "completion_policy",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "CONCURRENT_HTTP"
        },
        "requests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "operation_id",
              "method",
              "path_template",
              "resolved_path",
              "path_params",
              "query",
              "headers",
              "credential_refs",
              "body",
              "timeout_ms",
              "capture"
            ],
            "properties": {
              "type": {
                "const": "HTTP"
              },
              "operation_id": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "path_template": {
                "type": "string"
              },
              "resolved_path": {
                "type": "string"
              },
              "path_params": {
                "type": "object"
              },
              "query": {
                "type": "object"
              },
              "headers": {
                "type": "object"
              },
              "credential_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "body": {},
              "timeout_ms": {
                "type": "integer",
                "minimum": 1
              },
              "capture": {
                "type": "object"
              }
            }
          }
        },
        "barrier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hook",
            "participants"
          ],
          "properties": {
            "hook": {
              "const": "AFTER_AUTHORIZATION_BEFORE_ROW_LOCK"
            },
            "participants": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "completion_policy": {
          "const": "ALL"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "invocations"
      ],
      "properties": {
        "type": {
          "const": "CLI"
        },
        "invocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv",
              "cwd",
              "env_refs",
              "timeout_ms",
              "expect_exit_codes"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "env_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1
              },
              "expect_exit_codes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "browser",
        "base_url_ref",
        "steps",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "UI_FLOW"
        },
        "browser": {
          "const": "CHROMIUM"
        },
        "base_url_ref": {
          "type": "string",
          "pattern": "^env://"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "NAVIGATE",
                  "ASSERT_TEXT"
                ]
              },
              "target": {
                "type": "string"
              },
              "selector": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "program_id",
        "fixture_id",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "DB_PROGRAM"
        },
        "program_id": {
          "type": "string"
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^FX-"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "execution",
        "steps",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "DOMAIN_PROGRAM"
        },
        "execution": {
          "enum": [
            "SEQUENTIAL",
            "PARALLEL"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "op",
                  "step_id",
                  "command",
                  "aggregate_ref",
                  "payload",
                  "expected_version",
                  "idempotency_key",
                  "caused_by_event_ref",
                  "expect",
                  "capture"
                ],
                "properties": {
                  "op": {
                    "const": "COMMAND"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "aggregate_ref": {},
                  "payload": {
                    "type": "object"
                  },
                  "expected_version": {},
                  "idempotency_key": {
                    "type": "string"
                  },
                  "caused_by_event_ref": {},
                  "expect": {
                    "enum": [
                      "SUCCESS",
                      "REJECT"
                    ]
                  },
                  "capture": {
                    "type": "object"
                  },
                  "precondition_state": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "step_id",
                  "evaluator",
                  "input",
                  "expect",
                  "capture"
                ],
                "properties": {
                  "op": {
                    "const": "EVALUATE"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "evaluator": {
                    "enum": [
                      "EvaluateArrivalReports",
                      "EvaluateStopInactivity"
                    ]
                  },
                  "input": {
                    "type": "object"
                  },
                  "expect": {
                    "const": "SUCCESS"
                  },
                  "capture": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "steps",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "EVENT_PROGRAM"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "step_id",
                  "consumer_code",
                  "event_ref",
                  "mode"
                ],
                "properties": {
                  "op": {
                    "const": "CONSUME_EVENT"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "consumer_code": {
                    "enum": [
                      "alert-resolver",
                      "arrival-conflict-alert-handler",
                      "arrival-conflict-task-handler",
                      "arrival-evaluator",
                      "case-resume-handler",
                      "case-view-projector",
                      "conversation-link-suggester",
                      "demo-reset-coordinator",
                      "metrics-projector",
                      "search-projector",
                      "stop-inactivity-evaluator",
                      "stop-view-projector",
                      "task-resume-handler",
                      "timeline-projector",
                      "token-lifecycle-handler"
                    ]
                  },
                  "event_ref": {},
                  "mode": {
                    "enum": [
                      "LIVE",
                      "PROJECTION_REBUILD"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "step_id",
                  "aggregate_ref",
                  "resulting_aggregate_version",
                  "aggregate_sequence",
                  "expect"
                ],
                "properties": {
                  "op": {
                    "const": "PERSIST_EVENT"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "aggregate_ref": {},
                  "resulting_aggregate_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "aggregate_sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expect": {
                    "const": "SUCCESS"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "step_id",
                  "mode",
                  "generation_id",
                  "expect_no_live_only_effects"
                ],
                "properties": {
                  "op": {
                    "const": "REPLAY"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "mode": {
                    "const": "PROJECTION_REBUILD"
                  },
                  "generation_id": {},
                  "expect_no_live_only_effects": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "step_id",
                  "hook",
                  "execute",
                  "expect"
                ],
                "properties": {
                  "op": {
                    "const": "FAULT_INJECTION"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "hook": {
                    "enum": [
                      "AFTER_DOMAIN_EVENT_BEFORE_COMMIT"
                    ]
                  },
                  "execute": {
                    "const": "PERSIST_DOMAIN_EVENT_TRANSACTION"
                  },
                  "expect": {
                    "const": "FULL_ROLLBACK"
                  }
                }
              }
            ]
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "steps",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "WORKER_PROGRAM"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "step_id",
              "lease_generation_id",
              "active_generation_id",
              "expect"
            ],
            "properties": {
              "op": {
                "const": "COMMIT_LEASE"
              },
              "step_id": {
                "type": "string"
              },
              "lease_generation_id": {
                "type": "string",
                "format": "uuid"
              },
              "active_generation_id": {
                "type": "string",
                "format": "uuid"
              },
              "expect": {
                "const": "STALE_DEMO_GENERATION"
              }
            }
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "program_kind",
        "case_source",
        "case_ids",
        "base_test_ids",
        "configuration",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "PARAMETERIZED_PROGRAM"
        },
        "program_kind": {
          "type": "string"
        },
        "case_source": {
          "type": "string"
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "base_test_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "configuration": {
          "type": "object"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "rules",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "STATIC_ASSERTION"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "artifact",
              "value"
            ],
            "properties": {
              "op": {
                "enum": [
                  "ASSERT_OPERATION_ABSENT",
                  "DATASET_SCAN"
                ]
              },
              "artifact": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "program_id",
        "fixture_id",
        "timeout_ms"
      ],
      "properties": {
        "type": {
          "const": "SCENARIO"
        },
        "program_id": {
          "type": "string"
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^FX-"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  ]
}
