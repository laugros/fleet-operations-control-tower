{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/baseline/demo-r1-baseline-manifest.schema.json",
  "title": "DEMO-R1 Authorized Baseline Manifest v2.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_version",
    "release",
    "status",
    "generated_stage",
    "review_id",
    "final_review_required",
    "scaffold_authorized",
    "authorized_gate",
    "authorization_file",
    "manifest_protocol",
    "inventory",
    "historical_evidence_policy",
    "artifacts"
  ],
  "properties": {
    "baseline_version": {
      "const": "2.1.4"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "status": {
      "const": "NORMATIVE_AUTHORIZED_FOR_SCAFFOLD"
    },
    "generated_stage": {
      "const": "4_OF_4"
    },
    "review_id": {
      "const": "R7"
    },
    "final_review_required": {
      "const": false
    },
    "scaffold_authorized": {
      "const": true
    },
    "authorized_gate": {
      "const": "G1_FOUNDATION"
    },
    "authorization_file": {
      "const": "baseline/demo-r1-implementation-authorization.yaml"
    },
    "manifest_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_hash_included",
        "artifact_hash_algorithm",
        "path_base"
      ],
      "properties": {
        "self_hash_included": {
          "const": false
        },
        "artifact_hash_algorithm": {
          "const": "SHA-256"
        },
        "path_base": {
          "const": "REPOSITORY_ROOT"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifested_artifacts",
        "normative_artifacts_total",
        "normative_documents",
        "tests",
        "work_packages",
        "implementation_slices",
        "g1_work_packages",
        "g1_activation_tests",
        "g1_fixtures",
        "g1_schema_tables",
        "g1_seed_tables",
        "later_gates_blocked"
      ],
      "properties": {
        "manifested_artifacts": {
          "type": "integer",
          "minimum": 1
        },
        "normative_artifacts_total": {
          "type": "integer",
          "minimum": 1
        },
        "normative_documents": {
          "const": 11
        },
        "tests": {
          "const": 208
        },
        "work_packages": {
          "const": 59
        },
        "implementation_slices": {
          "const": 240
        },
        "g1_work_packages": {
          "const": 11
        },
        "g1_activation_tests": {
          "const": 26
        },
        "g1_fixtures": {
          "const": 9
        },
        "g1_schema_tables": {
          "const": 32
        },
        "g1_seed_tables": {
          "const": 32
        },
        "later_gates_blocked": {
          "const": true
        }
      }
    },
    "historical_evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "included_in_normative_artifacts"
      ],
      "properties": {
        "directory": {
          "const": "reviews/history/"
        },
        "included_in_normative_artifacts": {
          "const": false
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "sha256",
          "size_bytes",
          "normative"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "normative": {
            "const": true
          }
        }
      }
    }
  }
}
