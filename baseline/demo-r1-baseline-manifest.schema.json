{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fotc.local/demo-r1/baseline/demo-r1-baseline-manifest.schema.json",
  "title": "DEMO-R1 Baseline Manifest v2.1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_version",
    "release",
    "status",
    "generated_stage",
    "final_review_required",
    "scaffold_authorized",
    "manifest_protocol",
    "inventory",
    "historical_evidence_policy",
    "artifacts"
  ],
  "properties": {
    "baseline_version": {
      "const": "2.1.3"
    },
    "release": {
      "const": "DEMO-R1"
    },
    "status": {
      "const": "NORMATIVE_PENDING_FINAL_REVIEW"
    },
    "generated_stage": {
      "const": "3_OF_4"
    },
    "final_review_required": {
      "const": true
    },
    "scaffold_authorized": {
      "const": false
    },
    "manifest_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_hash_included",
        "artifact_hash_algorithm",
        "path_base"
      ],
      "properties": {
        "self_hash_included": {
          "const": false
        },
        "artifact_hash_algorithm": {
          "const": "SHA-256"
        },
        "path_base": {
          "const": "REPOSITORY_ROOT"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifested_artifacts",
        "normative_artifacts_total",
        "normative_documents",
        "requirements",
        "canonical_invariants",
        "data_adrs",
        "commands",
        "openapi_operations",
        "event_types",
        "tests",
        "resolved_fixtures",
        "database_programs",
        "scenario_programs",
        "runner_workers",
        "actor_profiles",
        "db_operation_codes",
        "work_packages",
        "implementation_slices",
        "dag_edges",
        "dag_cycles",
        "maximum_slice_points"
      ],
      "properties": {
        "manifested_artifacts": {
          "type": "integer",
          "minimum": 1
        },
        "normative_artifacts_total": {
          "type": "integer",
          "minimum": 1
        },
        "normative_documents": {
          "const": 11
        },
        "requirements": {
          "const": 59
        },
        "canonical_invariants": {
          "const": 18
        },
        "data_adrs": {
          "const": 15
        },
        "commands": {
          "const": 37
        },
        "openapi_operations": {
          "const": 44
        },
        "event_types": {
          "const": 33
        },
        "tests": {
          "const": 208
        },
        "resolved_fixtures": {
          "const": 98
        },
        "database_programs": {
          "const": 43
        },
        "scenario_programs": {
          "const": 8
        },
        "runner_workers": {
          "const": 4
        },
        "actor_profiles": {
          "const": 9
        },
        "db_operation_codes": {
          "const": 1
        },
        "work_packages": {
          "const": 59
        },
        "implementation_slices": {
          "type": "integer",
          "minimum": 1
        },
        "dag_edges": {
          "type": "integer",
          "minimum": 1
        },
        "dag_cycles": {
          "const": 0
        },
        "maximum_slice_points": {
          "type": "integer",
          "maximum": 5
        }
      }
    },
    "historical_evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "included_in_normative_artifacts"
      ],
      "properties": {
        "directory": {
          "const": "reviews/history/"
        },
        "included_in_normative_artifacts": {
          "const": false
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "sha256",
          "size_bytes",
          "normative"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "normative": {
            "const": true
          }
        }
      }
    }
  }
}
